# Local development only. Copy to .env and replace every REPLACE_ value.
# Never commit .env. In AWS these come from Secrets Manager / task definitions.

# --- PostgreSQL (docker-compose) ---
POSTGRES_SUPERUSER_PASSWORD=REPLACE_local_superuser_pw
AIEOS_OWNER_PASSWORD=REPLACE_local_owner_pw
AIEOS_API_PASSWORD=REPLACE_local_api_pw
# Migration/provisioning connection (table owner; bypasses RLS). Never used by the API at runtime.
OWNER_DATABASE_URL=postgresql+psycopg://aieos_owner:REPLACE_local_owner_pw@127.0.0.1:5432/aieos
# Runtime connection (member of aieos_app; subject to RLS).
DATABASE_URL=postgresql+psycopg://aieos_api:REPLACE_local_api_pw@127.0.0.1:5432/aieos

# --- API (Increment 1) ---
ENVIRONMENT=local
API_HOST=127.0.0.1
API_PORT=8000
LOG_JSON=true
# Local auth uses a dev signing key: `make dev-keys`, then `make token SUB=dev-owner`.
# In AWS set OIDC_JWKS_URL (https) instead of OIDC_JWKS_PATH.
OIDC_ISSUER=http://localhost/dev-issuer
OIDC_AUDIENCE=aieos-api
OIDC_JWKS_PATH=.dev-keys/jwks.json
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# --- Temporal ---
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=aieos-local
# Temporal Cloud only: API key (implies TLS). Leave empty locally.
TEMPORAL_API_KEY=
# temporal = API connects at startup; disabled = workflow routes answer 503 (API-only local runs)
ORCHESTRATOR_MODE=temporal

# --- S3-compatible artifact store ---
S3_ENDPOINT_URL=http://127.0.0.1:7070
S3_ACCESS_KEY_ID=REPLACE_local_s3_key
S3_SECRET_ACCESS_KEY=REPLACE_local_s3_secret
S3_ARTIFACT_BUCKET=aieos-artifacts-local
S3_FORCE_PATH_STYLE=true
S3_REGION=us-east-1
# SSE-KMS key id/ARN (AWS only; leave empty locally)
S3_KMS_KEY_ID=
ARTIFACT_MAX_BYTES=104857600
# Presigned URL lifetime, seconds (max 900)
PRESIGN_TTL_SECONDS=300

# --- Observability ---
# OTLP/HTTP; leave empty to disable tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=aieos-local
LOG_LEVEL=INFO

# --- Model providers (Increment 2). Model ids and prices live in engineering/model-routing.yaml ---
MODEL_ROUTING_PATH=engineering/model-routing.yaml
# Set only the providers you use. Default contracts: Anthropic for most agents, Gemini for QA/Security
# (a different model family, for independent review).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional OpenAI-compatible server (gateway, vLLM, Ollama); see the commented `local` provider.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=

# --- GitHub App (Increment 4). The private key is read from a file path, never inline. ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=

# --- Sandbox (gateway worker only) ---
# docker = local/CI: the gateway worker needs the Docker socket, which is root-equivalent on the host.
# Run the gateway worker on your machine (`make run-worker-gateway`), never mount the socket into a container.
SANDBOX_BACKEND=disabled
SANDBOX_IMAGE=aieos-sandbox:local
# gVisor runtime for stronger isolation, if installed: SANDBOX_RUNTIME=runsc
SANDBOX_RUNTIME=
SANDBOX_DEFAULT_CPUS=2
SANDBOX_DEFAULT_MEMORY_MB=2048
SANDBOX_DEFAULT_TIMEOUT_SECONDS=900
